# Database Connection URL (PostgreSQL)
# Production: Ensure SSL is enabled, e.g. postgresql://user:password@host:5432/db?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/reconcilo?schema=public"

# Server Port
PORT=4000

# Environment Mode ('development' | 'production' | 'test')
NODE_ENV=development

# Allowed Frontend Origins for CORS (Comma-separated for multiple origins)
# Example: https://lissafi.app,https://app.lissafi.app
ALLOWED_ORIGINS="http://localhost:5173,http://localhost:3000"

# Optional: JWT Secret for future authentication tokens
# JWT_SECRET="your-256-bit-secret-key-here"
