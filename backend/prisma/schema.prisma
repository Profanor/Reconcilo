datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

enum UserRole {
  ADMIN
  FINANCE_LEAD
  OPERATOR
  AUDITOR
}

enum ExpectedPaymentStatus {
  PENDING
  MATCHED
  PARTIAL
  EXPIRED
  DUPLICATE
}

enum ReceivedPaymentStatus {
  UNMATCHED
  MATCHED
  IGNORED
  DUPLICATE
}

enum PaymentChannel {
  BANK_TRANSFER
  POS
  WALLET
  CASH
}

enum MatchMethod {
  AUTOMATIC_EXACT
  CONFIRMED_SUGGESTION
  AUTOMATIC_FUZZY
  MANUAL
}

enum RuleType {
  EXACT_AMOUNT_AND_REF
  EXACT_AMOUNT_AND_NARRATIVE_REF
  EXACT_AMOUNT_AND_CUSTOMER_DETAILS
  EXACT_AMOUNT_AND_FUZZY_NAME
}

enum AuditAction {
  MANUAL_MATCH
  CONFIRM_SUGGESTION
  REJECT_SUGGESTION
  UNMATCH
  DUPLICATE_FLAGGED
  WORKSPACE_PROVISIONED
}

model Tenant {
  id          String   @id @default(uuid())
  name        String   // e.g. "Apex Superstores & Logistics Nigeria Ltd"
  slug        String   @unique // e.g. "apex-superstores"
  cacNumber   String?  // e.g. "RC-1849201"
  currency    String   @default("NGN")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users              User[]
  expectedPayments   ExpectedPayment[]
  receivedPayments   ReceivedPayment[]
  reconciliationRuns ReconciliationRun[]
  matches            ReconciliationMatch[]
  rules              ReconciliationRule[]
  auditLogs          AuditLog[]
}

model User {
  id        String   @id @default(uuid())
  tenantId  String
  email     String   @unique
  name      String
  role      UserRole @default(FINANCE_LEAD)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model ExpectedPayment {
  id            String                @id @default(uuid())
  tenantId      String
  amount        Float
  reference     String                // Order ID or invoice reference
  customerName  String
  customerPhone String?
  customerEmail String?
  status        ExpectedPaymentStatus @default(PENDING)
  createdAt     DateTime              @default(now())
  dueDate       DateTime?
  description   String?

  tenant        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  matches       ReconciliationMatch[]

  @@unique([tenantId, reference]) // Scope reference uniqueness to tenant
  @@index([tenantId, status])
  @@index([tenantId, reference])
}

model ReceivedPayment {
  id            String                @id // e.g. transaction session ID or unique reference
  tenantId      String
  amount        Float
  channel       PaymentChannel
  provider      String                // OPay, Moniepoint, GTBank, etc.
  reference     String                // Session ID, RRN, or provider transaction reference
  narrative     String?               // Full narration string
  senderName    String?               // Payer bank name
  senderAccount String?               // Payer account number or card PAN masked
  status        ReceivedPaymentStatus @default(UNMATCHED)
  createdAt     DateTime              // Transaction timestamp from provider
  ingestedAt    DateTime              @default(now())

  tenant        Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  matches       ReconciliationMatch[]

  @@unique([tenantId, reference]) // Scope reference uniqueness to tenant
  @@index([tenantId, status])
  @@index([tenantId, reference])
}

model ReconciliationMatch {
  id                String          @id @default(uuid())
  tenantId          String
  expectedPaymentId String
  receivedPaymentId String
  matchMethod       MatchMethod
  confidenceScore   Float           // 0.0 to 1.0
  matchedRules      String          // JSON array of matched rules, e.g. '["amount", "narrative_ref"]'
  matchedAt         DateTime        @default(now())
  matchedBy         String          @default("SYSTEM") // SYSTEM or user name/email
  notes             String?

  tenant            Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  expectedPayment   ExpectedPayment @relation(fields: [expectedPaymentId], references: [id], onDelete: Cascade)
  receivedPayment   ReceivedPayment @relation(fields: [receivedPaymentId], references: [id], onDelete: Cascade)

  @@unique([tenantId, expectedPaymentId, receivedPaymentId])
  @@index([tenantId])
}

model ReconciliationRun {
  id                String   @id @default(uuid())
  tenantId          String
  matchedCount      Int      @default(0)
  pendingExceptions Int      @default(0)
  actor             String   @default("SYSTEM")
  startedAt         DateTime @default(now())
  completedAt       DateTime @default(now())

  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model ReconciliationRule {
  id          String   // e.g. EXACT_AMOUNT_AND_REF
  tenantId    String
  name        String
  description String
  isActive    Boolean  @default(true)
  priority    Int      // Higher value = higher priority
  ruleType    RuleType
  config      String   @default("{}") // JSON string of parameters

  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, id])
  @@index([tenantId])
}

model AuditLog {
  id        String      @id @default(uuid())
  tenantId  String
  action    AuditAction
  targetId  String?     // Reference or ID
  user      String      // Email or name of authorized actor
  reason    String?     // Explanation/notes
  details   String?     // JSON metadata string
  createdAt DateTime    @default(now())

  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}
